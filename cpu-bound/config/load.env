# Load test configuration (read by scripts/run-load.sh on the machine that runs k6).

# Application URL as seen from the load generator (VirtualBox port forwarding host:port).
TARGET_URL=http://localhost:8080

# Each combination LIMIT x VUS is run REPETITIONS times.
# LIMIT = work per request; VUS = concurrent users (each sends a new request as soon as it gets a response).
LIMITS="100000 1000000"
VUS_LEVELS="1 2 4 8 16 32"
REPETITIONS=3
DURATION_SECONDS=60
# 1-VU warm-up (JIT) before each LIMIT; results are discarded.
WARMUP_SECONDS=15
# Pause between runs so the VM returns to idle.
COOLDOWN_SECONDS=10
# Requests slower than this count as timeouts (and errors).
REQUEST_TIMEOUT=30s

# Optional: SSH to the VM to collect CPU/RAM with scripts/monitor.sh during each run.
# Needs key-based login (ssh-copy-id). Empty = no resource collection.
VM_SSH=""                     # e.g. "-p 2222 aluno@localhost"
VM_APP_DIR="~/poi-atv2/cpu-bound"

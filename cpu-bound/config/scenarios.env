# VM provisioning scenarios. These values are only a record: set them in VirtualBox
# (Settings > System > Motherboard/Processor) with the VM powered off before each scenario.
# scripts/run-load.sh <name> copies the chosen values into results/<name>/meta.txt.
# Adjust or add scenarios (<NAME>_VCPUS / <NAME>_RAM_MB) to fit the host machine.

A_VCPUS=1; A_RAM_MB=1024
B_VCPUS=1; B_RAM_MB=2048
C_VCPUS=2; C_RAM_MB=2048
D_VCPUS=2; D_RAM_MB=4096

# Application configuration (read by scripts/run-app.sh inside the VM).
# Changing these values does NOT change the CPU/RAM of the VM: that is set in VirtualBox.

SERVER_PORT=8080
# Accepted range for the "limit" parameter of GET /api/primes.
PRIMES_MIN_LIMIT=2
PRIMES_MAX_LIMIT=10000000
# Maximum Tomcat request threads (Spring Boot default: 200). One request = one thread.
TOMCAT_MAX_THREADS=200
# Extra JVM flags, e.g. "-Xmx512m". Empty = JVM default (max heap = 1/4 of the VM RAM).
JAVA_OPTS=""
